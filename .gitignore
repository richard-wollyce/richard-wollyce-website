# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
.docs/*
docs/*
docs/*/*
# ...except the CV mirrors and the PRD, which are deliberately versioned.
# The English mirror was already tracked; its siblings are generated from the
# same source and keeping one of three in git is how the old one drifted.
!docs/richard-wollyce-cv.md
!docs/richard-wollyce-cv-pt-br.md
!docs/richard-wollyce-cv-es.md
!docs/richard-wollyce-portfolio-prd.md
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python bytecode from scripts/generate-cv.py
__pycache__/
